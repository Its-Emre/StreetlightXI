# Copy this file to ".env" and fill in your own values.

# MongoDB Atlas connection string. The database name at the end
# (after mongodb.net/) must be "streetlightxi" for this app.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/streetlightxi?retryWrites=true&w=majority

# Any long random string — used to sign login tokens.
JWT_SECRET=change-me-to-a-long-random-string

# The invite code your cricket group types while registering.
# Pick a word+number phrase only your group knows (no spaces).
# Share it with the group yourself — never post it publicly.
# Leave unset ONLY for local experiments: registration stays open.
GROUP_CODE=

# The client URL allowed to call this API (CORS).
CLIENT_URL=http://localhost:5173

PORT=5000
